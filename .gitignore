# Large regeneratable data/model caches -- not durable source, just cache.
# data/raw/: re-downloadable from cricsheet.org (see src/parse_cricsheet.py)
# models/candidates/*.pkl|*.cbm|*.csv: regenerate via the matching
#   backend/train_*.py / backend/build_*.py script for that candidate
# data/candidates/**/*.csv, data/reports/**/*.csv: regenerate via the
#   matching backend/build_*.py / backend/*_replay*.py script
# The small *.json validation/report files ARE committed -- they're the
# actual evidence, not the bulky intermediate artifacts.
data/raw/
models/candidates/**/*.pkl
models/candidates/**/*.cbm
models/candidates/**/*.csv
data/candidates/**/*.csv
data/reports/**/*.csv
